# Normalise line endings in the repository; check out native ones.
* text=auto eol=lf

# Windows-only build script still needs to stay runnable either way.
*.ps1 text eol=lf

# Binary assets: never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.m4a binary
*.mp3 binary
*.jks binary
*.apk binary
*.jar binary
